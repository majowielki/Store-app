{
  "ConnectionStrings": {
  "DefaultConnection": "Host=storeapp-db.postgres.database.azure.com;Database=store_audit_db;Username=sqladmin@storeapp-db;Password=admin123*;Port=5432;Ssl Mode=Require;",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "your-very-long-secret-key-here-at-least-32-characters-long-for-store-app",
