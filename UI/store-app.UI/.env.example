# Copy to .env.local for values that differ on your machine. Nothing here is needed for the
# default local setup: "npm run dev" proxies /api to the gateway on http://localhost:5000
# (see vite.config.ts), so the app and the API share an origin like they do behind nginx.

# Only when the API is on another origin (then the gateway must allow that origin with
# credentials, because the refresh token travels in a cookie)
# VITE_API_BASE_URL=http://localhost:5000/api/v1
