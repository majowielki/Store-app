#!/bin/sh
# Sourced by the nginx entrypoint before the templates are rendered: the upstream hostname in
# proxy_pass is resolved at request time through the platform's DNS (Docker's 127.0.0.11, the
# Container Apps resolver, ...), so nginx starts even when the gateway is not up yet.
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER="$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)"
  export NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"
fi
