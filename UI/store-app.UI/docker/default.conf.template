# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf.
# GATEWAY_UPSTREAM: where /api/ requests are proxied (e.g. http://gateway:5000).

# A WebSocket upgrade is passed on as one; any other request keeps the plain "close"
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The access log line without the query string, for the requests that carry a token in it
log_format without_query '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # The app's own files compressed (the stock nginx.conf leaves gzip off). Not the API's answers:
    # compressing a response that carries a token next to what a request sent opens it to BREACH.
    gzip            on;
    gzip_vary       on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types      text/css application/javascript text/javascript application/json text/xml application/xml text/plain image/svg+xml;

    # Runtime configuration must never be cached by the browser
    location = /config.js {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # Same-origin API: the browser talks to the UI host only, nginx forwards to the gateway.
    # A variable in proxy_pass makes nginx resolve the host per request instead of at start-up.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $gateway_upstream "${GATEWAY_UPSTREAM}";
        proxy_pass         $gateway_upstream$request_uri;
        proxy_http_version 1.1;
        # The upstream may be https (the gateway on Container Apps); SNI is needed then
        proxy_ssl_server_name on;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # The admin panel's live feed of orders: a WebSocket to the gateway. A browser cannot put a
    # header on it, so the access token travels in the query string - which this location leaves
    # out of the access log. SignalR pings every 15 seconds, well inside the read timeout.
    location = /api/v1/admin/orders/live {
        access_log         /var/log/nginx/access.log without_query;
        set $gateway_upstream "${GATEWAY_UPSTREAM}";
        proxy_pass         $gateway_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # The sitemaps of the catalogue and of the editorial pages come from their services; the
    # sitemap index (public/sitemap.xml) lists them next to the UI's own pages
    location ~ ^/sitemap-(?<sitemap>products|content)\.xml$ {
        set $gateway_upstream "${GATEWAY_UPSTREAM}";
        proxy_pass         $gateway_upstream/api/v1/$sitemap/sitemap.xml;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Hashed build assets can be cached for a long time
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        # The shop's public address in the files that need it absolute - index.html's picture for
        # social sites, robots.txt, the sitemap index - from SHOP_URL (16-shop-url.envsh)
        sub_filter       '%SHOP_URL%' '${SHOP_URL}';
        sub_filter_once  off;
        sub_filter_types text/plain text/xml;
        try_files $uri $uri/ /index.html;
    }
}
