# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf.
# GATEWAY_UPSTREAM: where /api/ requests are proxied (e.g. http://gateway:5000).
server {
    listen       80;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Runtime configuration must never be cached by the browser
    location = /config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # Same-origin API: the browser talks to the UI host only, nginx forwards to the gateway.
    # A variable in proxy_pass makes nginx resolve the host per request instead of at start-up.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $gateway_upstream "${GATEWAY_UPSTREAM}";
        proxy_pass         $gateway_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Hashed build assets can be cached for a long time
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
