{
  "openapi": "3.0.4",
  "info": {
    "title": "Store AuditLog Service",
    "description": "Store AuditLog Service API documentation",
    "version": "v1"
  },
  "paths": {
    "/api/v1/auditlog": {
      "get": {
        "tags": [
          "AuditLog"
        ],
        "summary": "Entries newest first, narrowed by any of entityName, entityId, userId, from and to\r\n(ISO 8601 instants). Pages hold 50 entries unless pageSize says otherwise, 100 at most.",
        "parameters": [
          {
            "name": "entityName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Entries at or after this instant. Offsets are honoured: \"2026-09-01T00:00:00+02:00\" is 22:00 UTC the day before.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Entries at or before this instant.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLogPagedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/auditlog/{id}": {
      "get": {
        "tags": [
          "AuditLog"
        ],
        "summary": "One entry; 404 for an unknown id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLog"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuditLog": {
        "required": [
          "action",
          "entityName",
          "id",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "action": {
            "type": "string"
          },
          "entityName": {
            "type": "string"
          },
          "entityId": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "nullable": true
          },
          "serviceName": {
            "type": "string",
            "nullable": true
          },
          "correlationId": {
            "type": "string",
            "description": "Id of the message that carried the event, for tracing back to the publisher.",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "description": "When the action happened in the publishing service (UTC).",
            "format": "date-time"
          },
          "details": {
            "type": "string",
            "description": "Business context as JSON (ids, amounts, counts).",
            "nullable": true
          },
          "oldValues": {
            "type": "string",
            "nullable": true
          },
          "newValues": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One business action in the audit trail, built from an event another service published.\r\nDeliberately narrow: identifiers, the acting user's id, the service and the business\r\nfields that changed. Nothing about the HTTP request and no personal data."
      },
      "AuditLogPagedResponse": {
        "required": [
          "hasNextPage",
          "hasPreviousPage",
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditLog"
            }
          },
          "totalCount": {
            "type": "integer",
            "description": "Rows in the whole listing, not on this page.",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "hasNextPage": {
            "type": "boolean",
            "readOnly": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "description": "One page of a listing, the same shape for every resource."
      },
      "StoreProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "description": "W3C trace id of the request, to find it in the logs.",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Messages per field of a 422 problem.",
            "nullable": true
          }
        },
        "additionalProperties": { },
        "description": "The error response as this store fills it, for the document only: the RFC 9457 members\r\nplus the trace id every problem carries and the field messages of a validation problem."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Access token issued by the identity service",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "AuditLog",
      "description": "Read API of the audit trail for administrators. Entries are written by the event\r\nconsumers only; there is no HTTP endpoint that accepts them."
    }
  ]
}
