{
  "openapi": "3.0.4",
  "info": {
    "title": "Store Identity Service",
    "description": "Store Identity Service API documentation",
    "version": "v1"
  },
  "paths": {
    "/api/v1/admin/users": {
      "get": {
        "tags": [
          "AdminUsers"
        ],
        "summary": "Accounts, newest first, filtered by a fragment of the e-mail or name and by activity.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isActive",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponsePagedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/admin/users/{userId}": {
      "get": {
        "tags": [
          "AdminUsers"
        ],
        "summary": "One account; 404 when the id is unknown.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Creates an account and signs it in; 409 when the e-mail is taken, 422 when the password is too weak.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs in with e-mail and password; 401 when they do not match, 423 while the account is locked.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/demo-login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs in as the demo customer, without a password.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/demo-admin-login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs in as the read-only demo administrator, without a password.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "A new access token for the session in the refresh cookie; the cookie is replaced with a\r\nnew refresh token. 401 without a cookie, with a spent or expired one, or after the\r\nsession was ended - the client signs in again then.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "The signed-in user's profile; 204 for an anonymous caller, so a client can ask without\r\nknowing whether its stored token is still good. 404 when the account no longer exists.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me/address": {
      "put": {
        "tags": [
          "Auth"
        ],
        "summary": "Replaces the delivery address stored in the profile; an empty value clears it.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAddressRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Ends the session: the refresh token family in the cookie is revoked and the cookie\r\nremoved. The access token stays valid until it expires (minutes); the client discards it.",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminUserResponse": {
        "required": [
          "createdAt",
          "email",
          "firstName",
          "id",
          "isActive",
          "lastName",
          "updatedAt",
          "userName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AdminUserResponsePagedResponse": {
        "required": [
          "hasNextPage",
          "hasPreviousPage",
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUserResponse"
            }
          },
          "totalCount": {
            "type": "integer",
            "description": "Rows in the whole listing, not on this page.",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "hasNextPage": {
            "type": "boolean",
            "readOnly": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "description": "One page of a listing, the same shape for every resource."
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "expiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "additionalProperties": false,
        "description": "A signed-in session: the bearer token, when it expires and whose it is."
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Body of POST /api/v1/auth/login. Rules: `LoginRequestValidator`."
      },
      "RegisterRequest": {
        "required": [
          "confirmPassword",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Body of POST /api/v1/auth/register. Rules: `RegisterRequestValidator` and the password policy."
      },
      "StoreProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "description": "W3C trace id of the request, to find it in the logs.",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Messages per field of a 422 problem.",
            "nullable": true
          }
        },
        "additionalProperties": { },
        "description": "The error response as this store fills it, for the document only: the RFC 9457 members\r\nplus the trace id every problem carries and the field messages of a validation problem."
      },
      "UpdateAddressRequest": {
        "required": [
          "simpleAddress"
        ],
        "type": "object",
        "properties": {
          "simpleAddress": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Body of PUT /api/v1/auth/me/address; an empty value clears the address. Rules: `UpdateAddressRequestValidator`."
      },
      "UserResponse": {
        "required": [
          "createdAt",
          "displayName",
          "email",
          "id",
          "isActive",
          "roles",
          "userName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string"
          },
          "simpleAddress": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Access token issued by the identity service",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "AdminUsers",
      "description": "Accounts as the admin panel sees them. The demo administrator sees the panel but not\r\npersonal data; true-admin sees real values."
    },
    {
      "name": "Auth",
      "description": "Sign-up, sign-in and the signed-in user's own profile. A sign-in answers with a short-lived\r\naccess token in the body and a refresh token in an httpOnly cookie scoped to this\r\ncontroller's path, so a script in the page can never read the refresh token."
    }
  ]
}
