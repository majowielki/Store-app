{
  "openapi": "3.0.4",
  "info": {
    "title": "Product Service API",
    "description": "Product Service API API documentation",
    "version": "v1"
  },
  "paths": {
    "/api/v1/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "A page of the public catalogue, filtered and sorted by the query.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "in": "query",
            "description": "One colour, as the shop's filter form sends it; the same as colors with a single value.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "materials",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "colors",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponsePagedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Creates a product; the body is validated before the action runs.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "One active product; 404 for an unknown or deleted id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Products"
        ],
        "summary": "Partial update: absent fields keep their value, the nullable ones can be cleared with null.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "summary": "Removes the product from the public catalogue but keeps the row, so past orders keep a\r\nvalid reference and an admin can reactivate it with an update.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/products/meta": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "The values the catalogue can be filtered by.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductsMeta"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products/admin": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Every product, inactive ones included, sorted by sortBy (id, price,\r\ntitle, company) in sortDir (asc, desc).",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "in": "query",
            "description": "One colour, as the shop's filter form sends it; the same as colors with a single value.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "materials",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "colors",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDir",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponsePagedResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/products/{id}/snapshot": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "What another service needs to know about a product (title, image, colours, the price the\r\ncustomer pays right now). Service-to-service only: callers present the internal API key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSnapshot"
                }
              }
            }
          },
          "default": {
            "description": "Error, as an RFC 9457 problem (application/problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token"
          },
          "403": {
            "description": "The signed-in user may not do this"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "enum": [
          "all",
          "sofas",
          "chairs",
          "tables",
          "beds",
          "mattresses",
          "desks",
          "tvStands",
          "bookcases",
          "wardrobes",
          "dressers",
          "nightstands",
          "sideboards",
          "rugs",
          "outdoorFurniture",
          "entrywayFurniture",
          "decor",
          "bathroomStorage",
          "bathroomFurniture",
          "bathroomMirrors",
          "kitchenCabinets",
          "kitchenIslands",
          "gardenSets",
          "kidsBeds",
          "kidsDesks",
          "tableLamps",
          "floorLamps"
        ],
        "type": "string"
      },
      "Company": {
        "enum": [
          "all",
          "modenza",
          "luxora",
          "artifex",
          "comfora",
          "homestead"
        ],
        "type": "string"
      },
      "CreateProductRequest": {
        "required": [
          "category",
          "colors",
          "company",
          "description",
          "image",
          "newArrival",
          "price",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "salePrice": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "discountPercent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "newArrival": {
            "type": "boolean"
          },
          "image": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "widthCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "heightCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "depthCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "weightKg": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Body of POST /api/v1/products. Rules: `CreateProductRequestValidator`."
      },
      "DecimalNullableOptional": {
        "type": "number",
        "description": "A request field that distinguishes \"not sent\" from \"sent as null\". A partial update can\r\nthen clear a value (`\"salePrice\": null`) as well as leave it alone (property absent),\r\nwhich a plain nullable property cannot express - both arrive as null.",
        "format": "double",
        "nullable": true
      },
      "GroupWithCategories": {
        "required": [
          "categories",
          "key",
          "name"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionItem"
            }
          }
        },
        "additionalProperties": false
      },
      "OptionItem": {
        "required": [
          "key",
          "name"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Option of a dropdown: the key sent back in queries and the label to show."
      },
      "ProductResponse": {
        "required": [
          "category",
          "colors",
          "company",
          "createdAt",
          "description",
          "effectivePrice",
          "groups",
          "id",
          "image",
          "isActive",
          "materials",
          "newArrival",
          "price",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "salePrice": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "discountPercent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "effectivePrice": {
            "type": "number",
            "description": "Price the customer pays (sale price or discounted price, else the list price).",
            "format": "double"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "newArrival": {
            "type": "boolean"
          },
          "image": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "widthCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "heightCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "depthCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "weightKg": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductResponsePagedResponse": {
        "required": [
          "hasNextPage",
          "hasPreviousPage",
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            }
          },
          "totalCount": {
            "type": "integer",
            "description": "Rows in the whole listing, not on this page.",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "hasNextPage": {
            "type": "boolean",
            "readOnly": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "description": "One page of a listing, the same shape for every resource."
      },
      "ProductSnapshot": {
        "required": [
          "colors",
          "company",
          "effectivePrice",
          "id",
          "image",
          "isActive",
          "price",
          "title",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Product id",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Display name"
          },
          "image": {
            "type": "string",
            "description": "Image URL"
          },
          "company": {
            "type": "string",
            "description": "Brand name as text"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Colour variants the product is sold in"
          },
          "price": {
            "type": "number",
            "description": "List price",
            "format": "double"
          },
          "effectivePrice": {
            "type": "number",
            "description": "The price a customer pays right now (sale price or discounted list price)",
            "format": "double"
          },
          "isActive": {
            "type": "boolean",
            "description": "False once the product was deleted from the catalogue"
          },
          "updatedAt": {
            "type": "string",
            "description": "Last change in the catalogue, for callers that cache",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "What the catalogue tells other services about a product: enough to show a cart line and\r\nto charge the right price. Returned by `GET /api/v1/products/{id}/snapshot`; the caller\r\nstores the fields it needs instead of keeping a copy of the product."
      },
      "ProductsMeta": {
        "required": [
          "categories",
          "colors",
          "companies",
          "groupCategoryMap",
          "groups"
        ],
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groupCategoryMap": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupWithCategories"
            },
            "description": "Groups with the categories that belong to them, for dependent dropdowns."
          }
        },
        "additionalProperties": false,
        "description": "The values the catalogue can be filtered by, for the shop's menus and the admin form.\r\nKeys use the same spelling as the product fields (\"tvStands\", \"modenza\"); \"all\" comes\r\nfirst so a menu can default to it."
      },
      "StoreProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "description": "W3C trace id of the request, to find it in the logs.",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Messages per field of a 422 problem.",
            "nullable": true
          }
        },
        "additionalProperties": { },
        "description": "The error response as this store fills it, for the document only: the RFC 9457 members\r\nplus the trace id every problem carries and the field messages of a validation problem."
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "salePrice": {
            "$ref": "#/components/schemas/DecimalNullableOptional"
          },
          "discountPercent": {
            "$ref": "#/components/schemas/DecimalNullableOptional"
          },
          "category": {
