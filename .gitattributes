# Normalise line endings: LF in the repository, native on checkout
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
*.json      text
*.yml       text
*.yaml      text
*.md        text
*.ts        text
*.tsx       text
*.css       text
*.html      text
*.sh        text eol=lf
# Read inside Linux containers, where a CR at the end of a line breaks them (the nginx entrypoint
# sources the .envsh scripts with sh), so a Windows checkout keeps LF too
*.envsh     text eol=lf
*.template  text eol=lf
Dockerfile  text eol=lf
*.sql       text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
