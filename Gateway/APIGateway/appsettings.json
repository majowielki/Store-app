{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "Store.API",
    "Audience": "Store.Client"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "RateLimiterPolicy": "auth"
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        },
        "RateLimiterPolicy": "api"
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/v1/cart/{**catch-all}"
        },
        "AuthorizationPolicy": "User",
        "RateLimiterPolicy": "api"
      },
      "pricing-rules-route": {
        "ClusterId": "orders-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/orders/pricing-rules"
        },
        "RateLimiterPolicy": "api"
      },
      "order-stats-route": {
        "ClusterId": "orders-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/orders/stats"
        },
        "RateLimiterPolicy": "api"
      },
      "wishlist-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/v1/wishlist/{**catch-all}"
        },
        "AuthorizationPolicy": "User",
        "RateLimiterPolicy": "api"
      },
      "discount-check-route": {
        "ClusterId": "orders-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/orders/discount-codes/{**catch-all}"
        },
        "RateLimiterPolicy": "api"
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "User",
        "RateLimiterPolicy": "api"
      },
      "content-admin-route": {
        "ClusterId": "content-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/content/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin"
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/content/{**catch-all}"
        },
        "RateLimiterPolicy": "api"
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "User",
        "RateLimiterPolicy": "api"
      },
      "reviews-admin-route": {
        "ClusterId": "reviews-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/reviews/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin"
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/reviews/{**catch-all}"
        },
        "RateLimiterPolicy": "api"
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/v1/auditlog/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin"
      },
      "admin-orders-route": {
        "ClusterId": "orders-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/admin/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin"
      },
      "admin-orders-live-route": {
        "ClusterId": "orders-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/admin/orders/live"
        },
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin",
        "Metadata": {
          "AccessTokenInQuery": "true"
        }
      },
      "admin-discount-codes-route": {
        "ClusterId": "orders-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/admin/discount-codes/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin"
      },
      "admin-route": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://identityservice:5001/"
          }
        }
      },
      "products-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://productservice:5003/"
          }
        }
      },
      "cart-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://cartservice:5005/"
          }
        }
      },
      "orders-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://orderservice:5006/"
          }
        }
      },
      "content-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://contentservice:5007/"
          }
        }
      },
      "payments-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://paymentservice:5008/"
          }
        }
      },
      "reviews-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://reviewservice:5009/"
          }
        }
      },
      "audit-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://auditlogservice:5004/"
          }
        }
      }
    }
  },
  "RateLimiting": {
    "Auth": {
      "WindowSeconds": 60,
      "PermitLimit": 60,
      "CredentialPermitLimit": 10
    }
  }
}
