{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "Store.API",
    "Audience": "Store.Client"
  },
  "AllowedOrigins": [
    "https://localhost:3000",
    "https://localhost:3001",
    "http://localhost:3000",
    "http://localhost:3001"
  ],
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "RateLimiterPolicy": "auth"
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/v1/cart/{**catch-all}"
        },
        "AuthorizationPolicy": "User"
      },
      "pricing-rules-route": {
        "ClusterId": "orders-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/orders/pricing-rules"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "User"
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/v1/auditlog/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin"
      },
      "admin-orders-route": {
        "ClusterId": "orders-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/admin/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin"
      },
      "admin-route": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://identityservice:5001/"
          }
        }
      },
      "products-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://productservice:5003/"
          }
        }
      },
      "cart-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://cartservice:5005/"
          }
        }
      },
      "orders-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://orderservice:5006/"
          }
        }
      },
      "audit-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://auditlogservice:5004/"
          }
        }
      }
    }
  },
  "RateLimiting": {
    "Auth": {
      "WindowSeconds": 60,
      "PermitLimit": 60,
      "CredentialPermitLimit": 10
    }
  }
}
