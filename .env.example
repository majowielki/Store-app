# Copy to .env; docker compose reads it. Nothing here has a default in the compose files:
# every password and key must be set, or compose refuses to start.
#
# Generate keys:   openssl rand -base64 48
#   PowerShell:    ./Scripts/Set-Local-Secrets.ps1 prints freshly generated keys
# Running the services outside Docker? Scripts/Set-Local-Secrets.ps1 puts the same values into
# dotnet user-secrets instead.

# --- required ---------------------------------------------------------------------------------

# PostgreSQL (every service has its own database in the one server)
POSTGRES_USER=store_user
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USER=store_user
RABBITMQ_PASSWORD=

# Signing key of the access tokens, min. 32 characters, the same in every service and the gateway
JWT_SECRET_KEY=

# Service-to-service key for the internal endpoints (product and cart snapshots, opening a payment), min. 32 characters
INTERNAL_API_KEY=

# Signs the payment service's webhooks to the order service, min. 32 characters
PAYMENT_WEBHOOK_SECRET=

# The seeded true-admin account; never generated, never logged
TRUE_ADMIN_EMAIL=trueadmin@store.com
TRUE_ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------------------------

# Production is the default of docker-compose.yml; docker-compose.dev.yml switches to Development
#ASPNETCORE_ENVIRONMENT=Production

# The showcase accounts and the password-less demo logins (docker-compose.dev.yml turns them on)
#DEMO_ENABLED=false

# Sign-ins per minute per client at the gateway; the end-to-end tests raise it
#AUTH_CREDENTIAL_LIMIT=10
# Other /auth calls per minute per client (a page load renews the session); the end-to-end tests raise it too
#AUTH_PERMIT_LIMIT=60

# The shop's public address, for the links that leave the API: sitemaps, robots.txt, e-mails and
# the picture shared on social sites. Defaults to http://localhost:$FRONTEND_PORT
#SHOP_URL=

# Where the hosts send traces, metrics and logs (docker-compose.dev.yml points at the Aspire dashboard)
#OTEL_EXPORTER_OTLP_ENDPOINT=

# Host ports
FRONTEND_PORT=8081
#GATEWAY_SERVICE_PORT=5000
#IDENTITY_SERVICE_PORT=5001
#PRODUCT_SERVICE_PORT=5003
#AUDIT_SERVICE_PORT=5004
#CART_SERVICE_PORT=5005
#ORDER_SERVICE_PORT=5006
#CONTENT_SERVICE_PORT=5007
#PAYMENT_SERVICE_PORT=5008
#POSTGRES_PORT=5432
#RABBITMQ_PORT=5672
#RABBITMQ_MANAGEMENT_PORT=15672
#ASPIRE_DASHBOARD_PORT=18888

# pgAdmin (docker-compose.tools.yml, profile "tools")
#PGADMIN_EMAIL=admin@store.local
#PGADMIN_PASSWORD=
#PGADMIN_PORT=8080
